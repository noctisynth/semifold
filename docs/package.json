{
  "name": "@semifold/docs",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "build": "next build --webpack",
    "check": "bun run typecheck && bun run test:install && bun run test:agents && bun run ./scripts/check-locales.mjs && bun run build && bun run ./scripts/check-static-output.mjs",
    "dev": "next dev",
    "generate": "bun run ./scripts/generate-source.mjs",
    "preview": "serve out --listen 4173",
    "test:install": "node --test scripts/install.test.mjs",
    "typecheck": "bun run generate && tsc --noEmit",
    "test:agents": "bun test scripts/agent-docs.test.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "fumadocs-core": "^16.17.10",
    "fumadocs-mdx": "^15.4.10",
    "fumadocs-ui": "^16.17.10",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
